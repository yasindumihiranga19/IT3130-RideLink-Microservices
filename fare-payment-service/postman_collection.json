{
  "info": {
    "name": "RideLink - Fare & Payment Service",
    "description": "Postman Collection for the RideLink Fare & Payment Microservice (Member 4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Fares",
      "item": [
        {
          "name": "1. Estimate Fare (Passenger/Driver)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"pickupLocation\": \"Colombo\",\n    \"destinationLocation\": \"Kandy\",\n    \"simulatedDistanceInKm\": 115.5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/fares/estimate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "fares",
                "estimate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Calculate Final Fare (Driver)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"rideId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/fares/calculate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "fares",
                "calculate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Process Payment (Passenger)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"rideId\": 1,\n    \"passengerId\": 10,\n    \"amount\": 850.50,\n    \"paymentMethod\": \"CREDIT_CARD\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/fares/pay",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "fares",
                "pay"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. Get Receipt (Passenger/Driver)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/fares/receipt/PASTE_PAYMENT_UUID_HERE",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "fares",
                "receipt",
                "PASTE_PAYMENT_UUID_HERE"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8084"
    },
    {
      "key": "auth_token",
      "value": "eyJhbGciOiJIUzI1NiJ9..."
    }
  ]
}
